     Full-screen countdown shown after the duress ("auto-destruct") fingerprint is matched at the
     keyguard. Deliberately opaque and unambiguous: this is a last chance to stop a device wipe, so
     nothing underneath should be legible or invite a mis-tap.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/duress_wipe_background"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/duress_wipe_title"
            android:textColor="@color/duress_wipe_foreground"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/duress_wipe_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/duress_wipe_foreground"
            android:textSize="96sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/duress_wipe_message"
            android:textColor="@color/duress_wipe_foreground"
            android:textSize="16sp"
            android:gravity="center" />

        <Button
            android:id="@+id/duress_wipe_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:minWidth="200dp"
            android:minHeight="56dp"
            android:text="@string/duress_wipe_cancel"
            android:textSize="18sp"
            android:textAllCaps="false" />

    </LinearLayout>

</FrameLayout>
